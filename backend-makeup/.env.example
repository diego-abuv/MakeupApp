PORT=3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave service_role do Supabase (ignora RLS). Obrigatório para o login do admin.
SUPABASE_SERVICE_KEY=

# ===== Autenticação =====
# Gere com: openssl rand -hex 32
JWT_SECRET=
# Chave para a rota de criação de admin (usada pelo script criar-admin)
ADMIN_KEY=

# ===== Sinal de 50% (Pix) =====
SINAL_PERCENTUAL=0.5
SINAL_TTL_MINUTOS=15

# ===== Gateway de pagamento =====
# asaas (homologação) | futuramente: mercadopago
GATEWAY_PRIMARY=asaas
# Sandbox do Asaas (para testes). Em produção usar https://api.asaas.com
ASSAAS_API_URL=https://api-sandbox.asaas.com
ASSAAS_API_KEY=
# Token usado para validar os webhooks do Asaas (mesmo valor configurado no painel Asaas)
ASSAAS_WEBHOOK_TOKEN=