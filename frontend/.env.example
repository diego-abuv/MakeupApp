# URL pública do backend (API NestJS). Em produção, use a URL de deploy
# (ex: https://seu-backend.onrender.com/api).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# WhatsApp de contato do estúdio (somente dígitos, com DDI + DDD).
# Ex: 5535999999999.
NEXT_PUBLIC_SHOP_WHATSAPP=5535999999999

# Nome do estúdio (usado na interface, no Open Graph e no rodapé).
NEXT_PUBLIC_SHOP_NAME=MakeupApp Studio

# Tagline exibida no topo da página inicial.
NEXT_PUBLIC_SHOP_TAGLINE=Beleza que valoriza

# Endereço público do site em produção (usado como og:url e og:image).
# NÃO usar aspas. Ex: https://seu-estudio.com.br
NEXT_PUBLIC_SHOP_ADDRESS=https://seu-estudio.com.br